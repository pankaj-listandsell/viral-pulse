APP_NAME="ViralPulse"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=viral_plush
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Admin account created by AdminUserSeeder (development only).
# Leave ADMIN_PASSWORD empty to have a random password generated and printed.
# --------------------------------------------------------------------------
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=admin@viralpulse.test
ADMIN_PASSWORD=

# --------------------------------------------------------------------------
# AI providers. Keys belong here only - never in the database, never in source,
# never sent to the client. A provider without a key is not offered in the admin;
# the admin picks between the configured ones from Settings.
# --------------------------------------------------------------------------
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

AI_MAX_TOKENS=16000
AI_TIMEOUT=180
AI_RETRIES=3
# Spend guard: checked before every call, so a stuck scheduler cannot run up a bill.
AI_DAILY_GENERATION_LIMIT=50

# --------------------------------------------------------------------------
# Content automation. AUTO_PUBLISH=false means AI writes drafts for review.
# --------------------------------------------------------------------------
AUTO_PUBLISH=false
AUTO_GENERATE_ENABLED=false
CONTENT_MIN_WORDS=400
CONTENT_MIN_QUALITY_SCORE=70

# --------------------------------------------------------------------------
# Trending sources. Published feeds and official APIs only - no scraping.
#
# Google Trends and Google News are on by default and need no key. Extra feeds
# are comma separated, each optionally pinned to a category:
#   TRENDING_RSS_FEEDS=https://example.com/feed.xml|technology,https://b.com/rss
# --------------------------------------------------------------------------
TRENDING_RSS_FEEDS=
NEWS_API_KEY=
TRENDING_REGION=IN
TRENDING_LANGUAGE=en
TRENDING_GOOGLE_TRENDS=true
TRENDING_GOOGLE_NEWS=true

# How the scheduler picks topics to write about.
TRENDING_GENERATE_PER_RUN=2
TRENDING_MIN_SCORE=45
TRENDING_MAX_AGE_HOURS=36
TRENDING_TARGET_WORDS=900

# --------------------------------------------------------------------------
# Publishing window. Generated articles are dripped out inside these hours
# rather than posted all at once - a burst of near-identical posts is exactly
# what Google's scaled-content policy looks for.
# --------------------------------------------------------------------------
PUBLISH_WINDOW_START=07:00
PUBLISH_WINDOW_END=22:00
PUBLISH_GAP_MINUTES=90
PUBLISH_MAX_PER_DAY=8
PUBLISH_LEAD_MINUTES=15

# --------------------------------------------------------------------------
# AdSense. Ad slots render nothing unless enabled and given a slot id.
# --------------------------------------------------------------------------
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_HEADER=
ADSENSE_SLOT_ARTICLE=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_FOOTER=

# Analytics
GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=

# Media (imagick is unavailable on this machine, so GD is the driver)
MEDIA_MAX_UPLOAD_KB=5120
MEDIA_IMAGE_DRIVER=gd
MEDIA_WEBP_ENABLED=true

# Data retention, enforced by the data:cleanup command
ANALYTICS_RETENTION_DAYS=90
ACTIVITY_LOG_RETENTION_DAYS=180
