APP_NAME="ViralPulse"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=viral_plush
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# Not "database". Every cache read becomes a query with that driver, which
# measured at ~29 extra queries on the home page and ~28 on an article. Switching
# to file took the home page from 34 queries to 5. Use redis if you have it.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Admin account created by AdminUserSeeder (development only).
# Leave ADMIN_PASSWORD empty to have a random password generated and printed.
# --------------------------------------------------------------------------
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=admin@viralpulse.test
ADMIN_PASSWORD=

# --------------------------------------------------------------------------
# AI providers. Keys belong here only - never in the database, never in source,
# never sent to the client. A provider without a key is not offered in the admin;
# the admin picks between the configured ones from Settings.
# --------------------------------------------------------------------------
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

AI_MAX_TOKENS=16000
# Spend guard: checked before every call, so a stuck scheduler cannot run up a bill.

# --------------------------------------------------------------------------
# Content automation. AUTO_PUBLISH=false means AI writes drafts for review.
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# Trending sources. Published feeds and official APIs only - no scraping.
#
# Google Trends and Google News are on by default and need no key. Extra feeds
# are comma separated, each optionally pinned to a category:
#   TRENDING_RSS_FEEDS=https://example.com/feed.xml|technology,https://b.com/rss
# --------------------------------------------------------------------------
NEWS_API_KEY=

# How the scheduler picks topics to write about.

# --------------------------------------------------------------------------
# Publishing window. Generated articles are dripped out inside these hours
# rather than posted all at once - a burst of near-identical posts is exactly
# what Google's scaled-content policy looks for.
# --------------------------------------------------------------------------
# Exact publishing times, comma separated - editable from Settings -> Publishing.
# Leave empty to space posts evenly using the window and gap below instead.

# Articles are written this close to the slot they are for, so trending content
# is not twenty hours stale by the time it publishes. 0 removes the limit.

# --------------------------------------------------------------------------
# AdSense. Ad slots render nothing unless enabled and given a slot id.
# --------------------------------------------------------------------------

# Analytics

# Media (imagick is unavailable on this machine, so GD is the driver)
MEDIA_IMAGE_DRIVER=gd
MEDIA_WEBP_ENABLED=true
# Draw a branded card for any post with no image of its own. Costs nothing and
# gives every article its own share picture.

# Data retention, enforced by the data:cleanup command

# --------------------------------------------------------------------------
# Everything else is edited in the admin under Settings, and on the AI
# Generator page for the provider and model. Those values live in the database
# so they can be changed without a deploy, and they override anything here.
#
# Only two kinds of value belong in this file:
#   - secrets. A key in the database ends up in every backup, every dump, and
#     on the settings screen itself.
#   - anything needed before the database is reachable: APP_KEY, APP_ENV,
#     APP_DEBUG, APP_URL, APP_TIMEZONE, DB_*, CACHE_STORE, QUEUE_CONNECTION.
# --------------------------------------------------------------------------
